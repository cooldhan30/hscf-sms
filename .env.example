# Supabase Configuration (SAME shared project as the marketing website)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only. NEVER prefix with NEXT_PUBLIC_ -- must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Clerk Configuration
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret_here

# Direct Postgres connection string, used only by scripts/migrate-to-clerk.ts
DATABASE_URL=your_database_url_here

# Email (payment reminders and future notification emails).
# Leave unset to fall back to opening the admin's own email client via a
# prefilled mailto: link. Set both to send server-side through Resend.
# RESEND_FROM must be on a domain verified in the Resend dashboard.
RESEND_API_KEY=
RESEND_FROM="TSCF School <noreply@tamilschoolfl.org>"

# Backblaze B2 (S3-compatible). Used for the 'submissions' bucket only --
# large audio recordings, kept off Supabase Storage's pricing tier.
B2_KEY_ID=your_b2_key_id_here
B2_APPLICATION_KEY=your_b2_application_key_here
B2_BUCKET=your_b2_bucket_name_here
B2_ENDPOINT=your_b2_endpoint_here

# Groq (OpenAI-compatible endpoint) -- powers the teacher Story Generator.
# Model is set in lib/groq.ts (see the comment there before changing it).
GROQ_API_KEY=your_groq_api_key_here
